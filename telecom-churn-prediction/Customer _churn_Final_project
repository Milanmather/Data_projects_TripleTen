    "# Creating target variable\n",
    "df['churn'] = (df['EndDate'] != 'No').astype(int)\n",
    "\n",
    "# Converting dates and creating tenure (months)\n",
    "df['BeginDate'] = pd.to_datetime(df['BeginDate'])\n",
    "analysis_date = pd.to_datetime('2020-02-01')\n",
    "\n",
    "df['tenure_months'] = ((analysis_date - df['BeginDate']) / pd.Timedelta(days=30)).astype(int)\n",
    "\n",
    "# Converting TotalCharges to numeric\n",
    "df['TotalCharges'] = pd.to_numeric(df['TotalCharges'], errors='coerce')\n",
    "df[['BeginDate', 'tenure_months']].head()\n"
